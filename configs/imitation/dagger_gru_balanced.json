{
  "env": {
    "instruction_text": "Find the red ball",
    "semantic_backend_mode": "clip",
    "fusion_alpha": 1.0,
    "clip_required": true,
    "clip_local_files_only": true,
    "semantic_update_interval_steps": 1,
    "action_repeat_steps": 6,
    "renderer": "HydraStorm",
    "headless": true
  },
  "bc": {
    "model_type": "gru",
    "model": {
      "input_dim": 196,
      "hidden_dim": 128,
      "num_layers": 1,
      "dropout": 0.0,
      "mlp_hidden_dims": [
        128
      ],
      "activation": "relu"
    },
    "dataset_paths": [
      "imitation_data/teacher_seed_balanced/teacher_seed_balanced_dataset.npz"
    ],
    "output_path": "models/student_gru_balanced.pt",
    "resume_from": null,
    "batch_size": 128,
    "epochs": 20,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "val_ratio": 0.1,
    "num_workers": 0,
    "shuffle_seed": 42,
    "class_weighting": "balanced",
    "device": "cpu",
    "tensorboard_log_dir": "tensorboard",
    "tb_run_name": "fish_imitation_dagger_student_gru_balanced",
    "checkpoint_dir": "checkpoints/imitation_dagger_gru_balanced",
    "checkpoint_every_epochs": 5,
    "sequence_length": 16,
    "sequence_stride": 4
  },
  "teacher_model_path": "models/fallback_teacher.zip",
  "teacher_algorithm": "recurrent_ppo",
  "seed_dataset_paths": [
    "imitation_data/teacher_seed_balanced/teacher_seed_balanced_dataset.npz"
  ],
  "initial_student_checkpoint": null,
  "output_root": "imitation_runs/dagger_gru_balanced",
  "total_iterations": 8,
  "rollout_episodes_per_iteration": 40,
  "start_seed": 42000,
  "deterministic_teacher": true,
  "deterministic_student": true,
  "beta_start": 0.8,
  "beta_end": 0.2,
  "resume_student_from_previous": true,
  "evaluate_episodes": 25,
  "scenario_plan": "balanced",
  "in_view_runs_per_iteration": 20,
  "out_of_view_runs_per_iteration": 20,
  "scenario_names": [],
  "runs_per_scenario": 1,
  "seed_stride": 101
}
