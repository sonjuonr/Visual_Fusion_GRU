{
  "env": {
    "instruction_text": "Find the red ball",
    "semantic_backend_mode": "clip",
    "fusion_alpha": 1.0,
    "clip_required": true,
    "clip_local_files_only": true,
    "semantic_update_interval_steps": 1,
    "action_repeat_steps": 6,
    "renderer": "HydraStorm",
    "headless": true
  },
  "policy_type": "torch_student",
  "policy_path": "models/student_bc_balanced.pt",
  "policy_algorithm": "recurrent_ppo",
  "observation_view_name": "clip",
  "episodes": 20,
  "start_seed": 42,
  "deterministic": true,
  "output_path": "imitation_data/eval/eval_student_balanced_summary.json"
}
